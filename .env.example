# Required: Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (default: gemini-2.5-pro)
# Use gemini-3.1-pro-preview for cutting-edge (preview access required)
GEMINI_MODEL=gemini-3-flash-preview

# Optional: request timeout in milliseconds for Gemini calls
# GEMINI_TIMEOUT_MS=35000
